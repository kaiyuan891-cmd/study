     System.out.println("str1 != str2");
    }
    String str3 = "123456";//截取字符串
         System.out.println(str3.substring(1,4));//234包括开始，不包括结束
        String str4 = "hello world";//判断是否包含
        System.out.println(str4.contains("hello"));
